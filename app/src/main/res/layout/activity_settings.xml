<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tips_header"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- 开关 -->
        <CheckBox
            android:id="@+id/cb_enable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/enable_module" />

        <CheckBox
            android:id="@+id/cb_desktop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_desktop" />

        <CheckBox
            android:id="@+id/cb_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_status" />

        <!-- 预览 -->
        <com.rainbow.statusbarlyric.view.RainbowLyricsView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:background="#1A000000" />

        <!-- 配色 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_color"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_colors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/colors_label" />

        <EditText
            android:id="@+id/et_colors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/colors_hint"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/row_swatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <!-- 动效 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_effect"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_flow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/flow_speed" />

        <SeekBar
            android:id="@+id/sb_flow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_breath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/breath_range" />

        <SeekBar
            android:id="@+id/sb_breath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/breath_period" />

        <SeekBar
            android:id="@+id/sb_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 扭曲 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_warp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/warp_effect" />

        <Spinner
            android:id="@+id/sp_warp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_warp_amp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/warp_amp" />

        <SeekBar
            android:id="@+id/sb_warp_amp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_warp_freq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/warp_freq" />

        <SeekBar
            android:id="@+id/sb_warp_freq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_warp_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/warp_speed" />

        <SeekBar
            android:id="@+id/sb_warp_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 消散 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_dissolve"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cb_dissolve"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dissolve_enable" />

        <TextView
            android:id="@+id/tv_dissolve_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dissolve_step" />

        <SeekBar
            android:id="@+id/sb_dissolve_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_dissolve_life"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dissolve_life" />

        <SeekBar
            android:id="@+id/sb_dissolve_life"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_dissolve_rise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dissolve_rise" />

        <SeekBar
            android:id="@+id/sb_dissolve_rise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_dissolve_spread"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dissolve_spread" />

        <SeekBar
            android:id="@+id/sb_dissolve_spread"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_dissolve_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dissolve_size" />

        <SeekBar
            android:id="@+id/sb_dissolve_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 陀螺仪摆动 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_tilt"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cb_tilt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tilt_enable" />

        <TextView
            android:id="@+id/tv_tilt_sens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tilt_sens" />

        <SeekBar
            android:id="@+id/sb_tilt_sens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 操作 -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/save" />

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset" />

        <Button
            android:id="@+id/btn_restart_netease"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/restart_netease" />

    </LinearLayout>
</ScrollView>
